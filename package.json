{
  "name": "agent-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted hub that runs several agent CLIs as a team",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "vite build",
    "start": "tsx src/server/index.ts --prod",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "format": "eslint --fix && prettier --write .",
    "demo:pm-be": "tsx scripts/demo-pm-be.ts",
    "test": "tsx scripts/test-workflow.ts",
    "lint": "eslint --max-warnings 0",
    "check": "npm run format && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "i18next": "^27.2.1",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^1.76.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  }
}
